#!/usr/bin/env bash
# Creates this repo's tickets as GitHub issues, one per file in
# .devcontainer/tickets/. The first line of each file is the title; the rest
# is the body. A ticket whose title is already an open issue is skipped, so
# running this again is safe. The Codespace is already signed in to GitHub.
#
#   bin/ticket
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v gh > /dev/null; then
  echo "bin/ticket: the gh command isn't installed here, so no issues were made." >&2
  echo "Open the files in .devcontainer/tickets/ and make each one an issue by hand." >&2
  exit 0
fi
if ! gh auth status > /dev/null 2>&1; then
  echo "bin/ticket: gh isn't signed in here, so no issues were made." >&2
  echo "Open the files in .devcontainer/tickets/ and make each one an issue by hand." >&2
  exit 0
fi

existing="$(gh issue list --state open --limit 100 --json title --jq '.[].title' 2>/dev/null || true)"

for file in .devcontainer/tickets/*.md; do
  title="$(head -n 1 "$file" | sed 's/^# *//')"
  if printf '%s\n' "$existing" | grep -qxF "$title"; then
    echo "Already open: $title"
    continue
  fi
  body="$(tail -n +2 "$file")"
  url="$(gh issue create --title "$title" --body "$body")"
  echo "Created: $title  $url"
done
